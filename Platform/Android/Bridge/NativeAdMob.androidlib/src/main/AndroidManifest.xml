<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- No android:screenOrientation here. Android 8.0 (API 26 only)
             throws "Only fullscreen opaque activities can request
             orientation" from Activity.onCreate when a translucent activity
             declares a fixed orientation - a hard crash before any of our
             code runs. onCreate requests portrait at runtime instead,
             skipping API 26, where a translucent activity follows the
             orientation of the opaque activity beneath it (the portrait
             game) anyway. -->
        <activity
            android:name="com.riseon.nativeadmob.OverlayAdActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:enableOnBackInvokedCallback="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:launchMode="standard"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- The full-screen cover. An Activity because only an Activity on
             top pauses the game below; the half-screen cover is a window and
             deliberately pauses nothing.

             Deliberately NOT android:noHistory. That flag finishes an
             Activity as soon as it stops, and an ad Activity opening on top
             stops this one - so the cover would be destroyed at exactly the
             moment it is covering the seam it was raised for, and be gone
             when the ad closes. Finish() owns the lifetime instead. -->
        <activity
            android:name="com.riseon.nativeadmob.FullScreenCoverActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:enableOnBackInvokedCallback="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:launchMode="singleTop"
            android:screenOrientation="behind"
            android:theme="@style/RiseOnFullScreenCoverTheme" />
    </application>
</manifest>
